# ==============================================================================
# VAYU-OPS Environment Configuration Template
# ==============================================================================
# IMPORTANT: This file is a template containing placeholders only.
# Never commit real credentials, production keys, or client secrets to git.
# Local development .env files (.env, .env.local, .env.*.local) are excluded
# from version control via .gitignore.
# ==============================================================================

# ------------------------------------------------------------------------------
# Gemini API Key (Server-Side)
# ------------------------------------------------------------------------------
# Required for Gemini AI decision-support explanations.
# In Google AI Studio, this is automatically injected at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ------------------------------------------------------------------------------
# Application URL
# ------------------------------------------------------------------------------
# The public base URL where this applet is hosted (e.g., Cloud Run service URL).
# AI Studio injects this automatically at runtime.
APP_URL="MY_APP_URL"

# ------------------------------------------------------------------------------
# OpenSky Network OAuth2 Credentials (Server-Side Only)
# ------------------------------------------------------------------------------
# How to obtain credentials:
# 1. Register for an account at https://opensky-network.org/
# 2. Access your profile / API settings to generate OAuth2 client credentials
#    (or request high-rate research access).
#
# Server-side isolation:
# - These variables are read STRICTLY server-side by `src/server/config.ts`.
# - They are NEVER exposed to the browser, NEVER prefixed with VITE_, and NEVER
#   included in client-side JavaScript bundles or API responses.
# - If omitted or left empty, VAYU-OPS automatically and safely operates in
#   anonymous mode (resilient live queries with cached Indian airspace vectors).
#
# Serverless / Cloud Hosting Deployment Configuration:
# - Google Cloud Run:
#     gcloud run services update vayu-ops \
#       --set-env-vars OPENSKY_CLIENT_ID="...",OPENSKY_CLIENT_SECRET="..." \
#       (or via Secret Manager: --set-secrets OPENSKY_CLIENT_SECRET=opensky-secret:latest)
# - Vercel / Netlify / Render:
#     Add OPENSKY_CLIENT_ID and OPENSKY_CLIENT_SECRET in the Dashboard under
#     Project Settings -> Environment Variables (do NOT select "Expose to browser").
# - AWS Lambda / ECS / Fargate:
#     Set in Lambda Configuration -> Environment variables or AWS Secrets Manager.
# - Docker / Container:
#     docker run -e OPENSKY_CLIENT_ID="..." -e OPENSKY_CLIENT_SECRET="..." ...

# OpenSky Network OAuth2 credentials
# Configure these variables in your SERVER environment.
# Never place real secrets in this file or commit them to version control.
# If omitted or left empty, the application safely operates in anonymous mode.
OPENSKY_CLIENT_ID="your_opensky_client_id_here"
OPENSKY_CLIENT_SECRET="your_opensky_client_secret_here"
